# Environment variable names read by the backend (and the frontend build).
# Copy to backend/.env and fill in values. Never commit real values.
# JWT_SECRET must be at least 32 characters (e.g. openssl rand -base64 48).
# Names only: defaults and semantics live in the code that reads each one.

# Core (required)
MONGO_URL=
DB_NAME=
JWT_SECRET=
FRONTEND_URL=

# Core (optional)
FRONTEND_ORIGIN_REGEX=
APP_ENV=
APP_URL=
PUBLIC_SITE_URL=
SUPPORT_DESK_URL=
ENABLE_DEMO_ROLE_SWITCH=
ENABLE_SCHEDULER=
SCHEDULER_TZ=
SENTINEL_TZ=
REDIS_URL=
TOKEN_ENCRYPTION_KEY=

# Stripe billing and invoice payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_INVOICE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_DATACLEAN_WEBHOOK_SECRET=
# Optional dashboard price ids for the DataClean products; each is used only
# when the price in Stripe is usd, monthly and equals the ladder amount.
STRIPE_PRICE_DATACLEAN=
STRIPE_PRICE_SECURITY=
STRIPE_PRICE_BUNDLE=
STRIPE_PLATFORM_FEE_MODE=
BILLING_ALLOW_LIVE=

# DataClean
